# This board's single USB-C connector wires to the ESP32-S3's native
# USB-Serial-JTAG peripheral, not to physical UART0 (GPIO43/44 are
# unconnected on this devkit). Confirmed empirically: with UART0 as the
# primary console, log output still appeared (via the USB-Serial-JTAG
# *secondary* console mirror, which is TX-only) but nothing ever arrived
# on UART0's RX no matter what was sent - the physical link simply isn't
# there. Using USB-Serial-JTAG as the primary console fixes both
# directions, since ESP-IDF wires stdin/stdout to it via VFS.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# Performance: the tick generator (core 1) and the stream ISRs (core 0)
# both benefit from full clock and real optimisation.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# 1 ms scheduler tick: timeouts in the motion/stream pipeline (prebuffer
# idle, underrun margin, link polling) are a few ms, which a 10 ms tick
# cannot express. Nothing in the fast paths depends on the tick any more.
CONFIG_FREERTOS_HZ=1000

# The stream ISRs (SPI pre/post callbacks, gate edge timer) call these from
# interrupt context.
CONFIG_GPTIMER_ISR_HANDLER_IN_IRAM=y
CONFIG_GPTIMER_CTRL_FUNC_IN_IRAM=y
CONFIG_SPI_MASTER_ISR_IN_IRAM=y

# Logs share the host link; keep runtime chatter low (raise with esp_log
# level calls when debugging).
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Gate-edge timer ISR must keep running during flash writes (NVS on a $ setting),
# otherwise a laser-off edge could be delayed by a flash operation.
CONFIG_GPTIMER_ISR_CACHE_SAFE=y

# 4 MB flash module (see platformio.ini board_upload.flash_size).
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# WiFi host link (docs/WIFI_PLAN.md): core 0 belongs to dac_task and the gate
# ISRs, so the network stack runs on core 1. The esp_timer task stays on
# core 0: moving it needs ESP_TIMER_SHOW_EXPERIMENTAL, which ESP-IDF warns
# may break other features. Its callbacks are short; the WiFi scope test in
# the plan decides whether that is acceptable.
CONFIG_ESP_WIFI_TASK_PINNED_TO_CORE_1=y
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU1=y

# WiFi memory (internal RAM is tight; the host link moves a few KB/s).
# Credentials live in our own NVS namespace, so WiFi must not write its own.
CONFIG_ESP_WIFI_NVS_ENABLED=n
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n
CONFIG_LWIP_MAX_SOCKETS=4
