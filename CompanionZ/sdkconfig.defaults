# Console on the native USB-Serial-JTAG; UART0 (GPIO20/21) carries STEP/DIR.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=n
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_FREERTOS_HZ=1000
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_HTTPD_WS_SUPPORT=y
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096
# ESPFleet agent: OTA with rollback (the agent confirms the image after the first hub heartbeat, zb_fleet after 90 s)
CONFIG_APP_ROLLBACK_ENABLE=y
CONFIG_ESPFLEET_AGENT_STACK=8192
CONFIG_ESPFLEET_WEB_UI_PORT=80

# sys_evt (default event loop) ran at 944 B headroom on the stock 2304 B; WiFi/IP handlers run here
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
