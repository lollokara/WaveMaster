# Extra settings for the debug build: pio run -e esp32-s3-devkitc-1-debug
# (see platformio.ini). They are read after sdkconfig.defaults.
#
# PlatformIO only regenerates sdkconfig.<env> when sdkconfig.defaults changes; after editing this file delete
# sdkconfig.esp32-s3-devkitc-1-debug so it is rebuilt.

# Turns on src/debug_tools.c and src/freeze_watch.c.
CONFIG_WM_DEBUG=y

# A panic or watchdog reset leaves its summary in the coredump partition; debug_tools.c logs it to the hub on the
# next boot. The dump holds every task's stack and stays in flash until the next crash replaces it.
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y

# A starved task (the task watchdog fires after 5 s) must panic, so the dump and the console show what held the
# core. Without it only the hardware stage resets the chip and nothing is recorded.
CONFIG_ESP_TASK_WDT_PANIC=y

# The panic report is printed to the USB console before the dump is written, with a 10 s RTC watchdog armed. A
# host that holds the port open without reading it can make the printing outlast the watchdog (reset reason
# "wdt", no dump). Uncomment to reboot silently when a session is not draining the console.
# CONFIG_ESP_SYSTEM_PANIC_SILENT_REBOOT=y
